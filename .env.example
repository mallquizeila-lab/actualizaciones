# Puedes pegar las claves aqui o, mas facil, en el panel: Ajustes -> Claves.

# IA principal, gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# IA de respaldo, gratis: https://console.groq.com/keys
GROQ_API_KEY=
# IA de respaldo, gratis: https://build.nvidia.com/
NVIDIA_API_KEY=
# Opcional, de pago: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Fotos de fondo, gratis: https://www.pexels.com/api/
PEXELS_API_KEY=
# Mas fotos, gratis: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Fase 2 (nichos y competencia), gratis: https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Imagenes con IA, gratis con UNA cuenta: https://dash.cloudflare.com/ (Workers AI)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Efectos y musica CC0 gratis: https://freesound.org/apiv2/apply
FREESOUND_API_KEY=
# Publicar en YouTube (guia en Ajustes): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Publicar en Facebook (guia en Ajustes): https://developers.facebook.com/apps/
FB_APP_ID=
FB_APP_SECRET=
